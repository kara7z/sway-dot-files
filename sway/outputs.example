# Inactive example: way-displays/cfg.yaml controls the active display layout.
# Adapt connector names/modes for your hardware. Do not enable this file's
# include while way-displays manages outputs.

output "eDP-1" {
    mode 1920x1200@60Hz
    pos 0 0
    transform normal
    scale 1.0
    adaptive_sync off
}
output "HDMI-A-1" {
    mode 1920x1080@60Hz
    pos 1920 0
    transform normal
    scale 1.0
    adaptive_sync off
}
# Overlapping output positions do not clone Sway workspaces.
# Use sway-display-toggle for mirroring with wl-mirror.
