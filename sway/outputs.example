# Generated by nwg-displays — sanitized example, copy to ~/.config/sway/outputs and adapt
# Do not commit real outputs with serials; use this template.

output "eDP-1" {
    mode  1920x1080@60Hz
    pos 0 0
    transform normal
    scale 1.0
    scale_filter nearest
    adaptive_sync off
    dpms on
}
output "HDMI-A-1" {
    mode  3840x2160@60Hz
    pos 1920 0
    transform normal
    scale 1.0
    scale_filter nearest
    adaptive_sync off
    dpms on
}
# Example alternative for mirror:
# output "HDMI-A-1" { mode 3840x2160@60Hz scale 2.0 pos 0 0 }
