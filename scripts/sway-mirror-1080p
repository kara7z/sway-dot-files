#!/bin/bash
# Legacy alias. The old "true clone at 1080p" is impossible on this panel:
# eDP-1 only exposes 1920x1200@60 and @48, so a 1080p hardware clone would
# downscale the laptop screen. It now behaves as the software duplicate:
# `sway-display-toggle --software-only` (wl-mirror, SHM backend, fit scaling).
exec ~/.local/bin/sway-display-toggle --software-only "$@"
