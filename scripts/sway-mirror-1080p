#!/bin/bash
# Mirror at 1080p — waybar perfect match (no scaling issue), HDMI downscaled
swaymsg output HDMI-A-1 mode 1920x1080@60Hz scale 1.0 pos 0 0
swaymsg output eDP-1 mode 1920x1080@60Hz scale 1.0 pos 0 0
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 & disown
notify-send "Mirror 1080p" "Perfect waybar, HDMI downscaled (TV upscales)" 2>/dev/null || echo "Mirror 1080p"
