#!/bin/bash
# Legacy alias (kept so old binds/notes keep working): software duplicate of the
# main screen on the connected external = `sway-display-toggle --software-only`.
# The real logic lives in sway-display-toggle, including the 2026-09-24 SHM
# backend fix for the 10-bit eDP-1 framebuffer (DMA-BUF/GL import fails there).
exec ~/.local/bin/sway-display-toggle --software-only "$@"
