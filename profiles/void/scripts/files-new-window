#!/bin/sh
# Ask Nautilus directly for a new window, activating its service if needed.
gdbus call --session \
    --dest org.gnome.Nautilus \
    --object-path /org/gnome/Nautilus \
    --method org.freedesktop.Application.ActivateAction \
    new-window '[]' '{}' >/dev/null 2>&1 && exit 0

exec nautilus --new-window
